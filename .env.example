# Copy this file to .env and fill in your values before starting.
DAILY_LEGACY_MAIN="__BUNDLE_DIR__/legacy/main.py"
DAILY_RUNTIME_DIR="__BUNDLE_DIR__/runtime"
DAILY_BRIDGE_PORT=8767

# Required for normal production report generation.
SM_DATA_SQL_HOST=
SM_DATA_SQL_PORT=3306
SM_DATA_SQL_USER=
SM_DATA_SQL_PASSWORD=
SM_DATA_SQL_DATABASE=

# Required: generated reports are downloaded from and uploaded to this Dify dataset.
DAILY_ENABLE_EXTERNAL_DELIVERY=true
DAILY_KNOWLEDGE_PROVIDER=dify
DIFY_DATASET_BASE_URL=http://localhost/v1
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=

# Optional: comma-separated names, for example 张三,张洋.
DAILY_ALLOWED_OPERATORS=

# Do not enable for production.
DAILY_FIXTURE_MODE=false
DAILY_FIXTURE_PATH="__BUNDLE_DIR__/fixtures/daily_query_fixture.json"
DAILY_ALLOW_LEGACY_DEFAULT_CREDENTIALS=false
